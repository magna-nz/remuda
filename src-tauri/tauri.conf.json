{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remuda",
  "version": "0.1.0",
  "identifier": "nz.magna.remuda",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../app"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../app"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Remuda",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
